# Endereço público que o cliente abrirá para consultar protocolo e senha
APP_PUBLIC_URL=http://SEU-IP-LOCAL:3001/#/consulta
APP_TIMEZONE=America/Manaus
CORS_ORIGIN=https://sistema.tabelionatomanacapuru.com
ADMIN_EMAIL=administrador@seu-dominio.com
ADMIN_PASSWORD=use-uma-senha-forte
JWT_SECRET=gere-uma-chave-aleatoria-longa

# PostgreSQL privado da aplicação (use uma senha longa e exclusiva)
POSTGRES_DB=sistema_escrituras
POSTGRES_USER=escrituras_app
POSTGRES_PASSWORD=gere-uma-senha-forte-para-o-banco

# Servidor de envio de e-mail (SMTP)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua-senha-de-aplicativo
SMTP_FROM="Cartório Santiago <seu-email@dominio.com>"
