{
  "name": "sistema-escrituras",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de Controle de Escrituras - Aplicação Desktop Multi-Usuário",
  "author": "Iago Feitosa - Feitosa Soluções em Informática",
  "homepage": "https://Feitosa98.github.io/escrituras",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:3001 && electron .\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "generate-icon": "node electron/generate-icon.js",
    "migrate:postgres": "node backend/migrate-sqlite-to-postgres.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "concurrently": "^8.2.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "exceljs": "^4.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.17",
    "vite": "^7.3.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.feitosa.escrituras",
    "productName": "Sistema de Escrituras",
    "copyright": "Copyright © 2026 Feitosa Soluções em Informática",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "electron"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Escrituras",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    }
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
